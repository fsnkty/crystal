{
    "autoUpdate": true,
    "autoUpdateNotification": true,
    "enabledThemes": [
        "DisblockOrigin.theme.css"
    ],
    "disableMinSize": true,
    "plugins": {
        "CommandsAPI": {
            "enabled": true
        },
        "MessageAccessoriesAPI": {
            "enabled": true
        },
        "MessageEventsAPI": {
            "enabled": true
        },
        "UserSettingsAPI": {
            "enabled": true
        },
        "ClearURLs": {
            "enabled": true
        },
        "CrashHandler": {
            "enabled": true
        },
        "NoF1": {
            "enabled": true
        },
        "NoServerEmojis": {
            "enabled": true,
            "shownEmojis": "currentServer"
        },
        "BadgeAPI": {
            "enabled": true
        },
        "NoTrack": {
            "enabled": true,
            "disableAnalytics": true
        },
        "Settings": {
            "enabled": true,
            "settingsLocation": "aboveNitro",
            "includeVencordInfoWhenCopying": true
        },
        "ConcatenatedComponentExtractor": {
            "enabled": true
        },
        "SupportHelper": {
            "enabled": true
        }
    },
    "uiElements": {
        "chatBarButtons": {},
        "messagePopoverButtons": {}
    },
    "notifications": {
        "timeout": 5000,
        "position": "bottom-right",
        "useNative": "not-focused",
        "logLimit": 50
    }
}